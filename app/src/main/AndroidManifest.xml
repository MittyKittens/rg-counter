<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to post and maintain the persistent counter notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Needed to start and maintain the foreground CounterService -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Re-start the watcher after device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <!-- Required for Shizuku availability checks -->
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_rotate"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RgCounter">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Foreground service that holds the persistent count notification.
            foregroundServiceType="dataSync" is required when targeting API 34+.
        -->
        <service
            android:name=".CounterService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!--
            Catches explicit broadcasts fired by the Shizuku UserService
            (HingeUserService running as shell uid) and updates the counter.
            Manifest receivers bypass Android 12 background-start restrictions.

            android:exported="true" is required because the broadcaster is `am broadcast`
            running as shell uid — not a package that could be restricted with a
            signature-level permission. The broadcast action names are app-specific
            ("rgcounter.*") so accidental collisions with other apps are unlikely.
            Worst-case impact of a malicious broadcast: the counter increments or
            decrements incorrectly — there is no sensitive data exposure.
        -->
        <receiver
            android:name=".HingeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="rgcounter.HINGE_OPEN" />
                <action android:name="rgcounter.HINGE_CLOSE" />
            </intent-filter>
        </receiver>

        <!-- Required by the Shizuku library -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>
